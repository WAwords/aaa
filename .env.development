# 工作环境接口地址(使用/api而不用真实的地址是因为配置了代理服务解决开发跨域问题)
VITE_API_BASE_URL = '/api'

# 工作环境代理到的主机地址
VITE_API_BASE_URL_HOST = 'http://192.168.1.210:8080'

# websocket地址
VITE_API_WS_BASE_URL = 'ws://192.168.1.210:8080'

# 开发环境mock(集中控制是否mock，如代理里的mock和动态路由mock，动态路由单独mock是因为动态路由的假数据是前端写的)
VITE_API_USE_MOCK = false
